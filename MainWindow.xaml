<Window x:Class="DeskCritters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskCritters"
        Width="180"
        Height="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="False"
        ShowInTaskbar="True"
        ResizeMode="NoResize">

    <Grid>

        <Polygon x:Name="DragonWings"
                 Points="42,68 4,42 16,110 42,96"
                 Fill="#8E5BD6"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Polygon x:Name="DragonWingRight"
                 Points="138,68 176,42 164,110 138,96"
                 Fill="#8E5BD6"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Ellipse x:Name="DogEarLeft"
                 Width="26"
                 Height="46"
                 Fill="#8A5A33"
                 Stroke="#684126"
                 StrokeThickness="3"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="30,16,0,0"
                 Visibility="Collapsed"/>

        <Ellipse x:Name="DogEarRight"
                 Width="26"
                 Height="46"
                 Fill="#8A5A33"
                 Stroke="#684126"
                 StrokeThickness="3"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,16,30,0"
                 Visibility="Collapsed"/>

        <Polygon x:Name="CatEarLeft"
                 Points="56,50 66,14 86,40"
                 Fill="#FFB464"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Polygon x:Name="CatEarRight"
                 Points="94,40 114,14 124,50"
                 Fill="#FFB464"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Polygon x:Name="ElfEarLeft"
                 Points="40,76 6,58 38,100"
                 Fill="#FFD9B3"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Polygon x:Name="ElfEarRight"
                 Points="140,76 174,58 142,100"
                 Fill="#FFD9B3"
                 Stroke="#684126"
                 StrokeThickness="3"
                 Visibility="Collapsed"/>

        <Ellipse x:Name="CritterBody"
                 Width="100"
                 Height="100"
                 Fill="#64DC96"
                 Stroke="#684126"
                 StrokeThickness="4"
                 VerticalAlignment="Center"
                 MouseLeftButtonDown="Critter_MouseLeftButtonDown">

            <Ellipse.ContextMenu>
                <ContextMenu>

                    <MenuItem Header="Change Species">
                        <MenuItem Header="Slime"
                                  Tag="Slime"
                                  Click="Species_Click"/>

                        <MenuItem Header="Cat"
                                  Tag="Cat"
                                  Click="Species_Click"/>

                        <MenuItem Header="Dog"
                                  Tag="Dog"
                                  Click="Species_Click"/>

                        <MenuItem Header="Dragon"
                                  Tag="Dragon"
                                  Click="Species_Click"/>

                        <MenuItem Header="Elf"
                                  Tag="Elf"
                                  Click="Species_Click"/>
                    </MenuItem>

                    <Separator/>

                    <MenuItem x:Name="PauseMenuItem"
                              Header="Pause Movement"
                              Click="Pause_Click"/>

                    <MenuItem Header="Toggle Desktop Mode"
                              Click="DesktopMode_Click"/>

                    <Separator/>

                    <MenuItem Header="Exit DeskCritters"
                              Click="Exit_Click"/>

                </ContextMenu>
            </Ellipse.ContextMenu>

        </Ellipse>

        <StackPanel x:Name="FacePanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">

            <TextBlock Text="•   •"
                       FontSize="27"
                       Foreground="#34251D"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="ᴗ"
                       FontSize="23"
                       Foreground="#34251D"
                       HorizontalAlignment="Center"/>

        </StackPanel>

        <TextBlock x:Name="CritterLabel"
                   Text="DeskCritters"
                   Foreground="White"
                   Background="#99000000"
                   Padding="5,3"
                   FontSize="11"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,2"
                   IsHitTestVisible="False"/>

    </Grid>
</Window>